{
  "openapi_schema": {
    "openapi": "3.0.0",
    "info": {
      "title": "Multipart Reference API",
      "version": "1.0.0"
    },
    "paths": {
      "/upload": {
        "post": {
          "operationId": "uploadFiles",
          "requestBody": {
            "$ref": "#/components/requestBodies/Upload"
          },
          "responses": {
            "204": {
              "description": "Upload complete"
            }
          }
        }
      }
    },
    "components": {
      "requestBodies": {
        "Upload": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadPayload"
              }
            }
          }
        }
      },
      "schemas": {
        "UploadPayload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "expected_sdk": {
    "fileName": "multipartReferenceAPI.ts",
    "expectedSubstrings": [
      "export interface UploadPayload",
      "Object.entries(uploadBody ?? {}).forEach(([key, value]) => {",
      "typeof value === \"string\" ? value",
      "Object.keys(value).every((key) => [\"data\", \"filename\", \"content_type\"].includes(key), )",
      "value.filename === undefined",
      "typeof value.filename === \"string\"",
      "typeof value.content_type === \"string\"",
      "JSON.stringify(value)",
      "formData.append(key, formDataValue as any);"
    ]
  }
}
